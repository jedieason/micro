{
  "manifest_version": 3,
  "name": "臺大玻片跑臺機",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "選取台大玻片，以 Organ 與 Diagnosis 練習閱片。影像由原網站載入。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://microteaching.ntu.edu.tw/*",
    "http://microteaching.ntu.edu.tw/*"
  ],
  "side_panel": {
    "default_path": "pages/index.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://microteaching.ntu.edu.tw/*",
        "http://microteaching.ntu.edu.tw/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "開啟臺大玻片跑臺機",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://microteaching.ntu.edu.tw/*",
        "http://microteaching.ntu.edu.tw/*"
      ],
      "js": [
        "content/scanner.js",
        "content/site.js"
      ],
      "css": [
        "content/mask.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://microteaching.ntu.edu.tw/*",
        "http://microteaching.ntu.edu.tw/*"
      ],
      "js": [
        "content/table-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://microteaching.ntu.edu.tw/*",
        "http://microteaching.ntu.edu.tw/*"
      ],
      "js": [
        "content/exam-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
